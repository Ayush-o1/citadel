# Leave empty to use the Vite dev proxy (see vite.config.js).
# Set to a full URL (e.g. https://api.example.com) when the client and API
# are not served from the same origin, such as in production.
VITE_API_URL=

# Firebase web app config -- from Firebase Console -> Project Settings ->
# General -> "Your apps" -> the web app (create one if none exists) ->
# SDK setup and configuration -> Config. These are NOT secret in the way
# an API key normally is: Firebase's client config is meant to be public
# (it's visible in any deployed page's JS bundle by design) and is
# protected by Firebase Security Rules / authorized domains instead, not
# by keeping it hidden. Still not committed here, matching how every
# other env var in this file is handled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
