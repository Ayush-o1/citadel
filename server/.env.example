# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# Origin allowed to call this API in dev (the Vite client)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string
# Local dev example: postgresql://<username>:<password>@localhost:5432/citadel
# Docker Compose example: postgresql://citadel:citadel_dev_password@postgres:5432/citadel
# Hosted (Neon) example: postgresql://<user>:<password>@<host>.neon.tech/citadel?sslmode=require
#   (NODE_ENV=production also makes the app require SSL — see src/config/db.js)
DATABASE_URL=postgresql://username:password@localhost:5432/citadel

# Google Sign-In, via Firebase Authentication. The client SDK
# (client/.env's VITE_FIREBASE_* vars) handles the actual Google OAuth
# popup; this is only used to verify the ID token it produces.
#
# Get this from Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key. Paste the ENTIRE downloaded JSON file's
# contents as one value (most shells/editors handle a multi-line env var
# fine in a .env file when it's wrapped in single quotes like this).
# Never commit the downloaded file itself -- .gitignore already blocks
# *firebase-adminsdk*.json regardless of where it lands.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Signs session JWTs. Any long random string; rotating it invalidates all
# sessions. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
